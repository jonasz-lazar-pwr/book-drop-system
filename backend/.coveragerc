[run]
source =
    api
    core
    models
    schemas
    services
omit =
    */__init__.py
    */tests/*
    */utils/*
    core/middleware.py
    api/main.py

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
    pass
show_missing = True
sort = Name